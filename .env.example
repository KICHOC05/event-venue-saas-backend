# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or share it through chat, tickets, logs, or images.

# Spring Boot
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Keep NONE unless the backend is behind a trusted reverse proxy that removes
# client-supplied forwarding headers and writes its own trusted values.
SERVER_FORWARD_HEADERS_STRATEGY=NONE

# MariaDB
DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=replace-with-a-strong-secret
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
DB_USE_SSL=true

# HikariCP
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_POOL_NAME=spacekids-primary

# Observability (non-secret)
HTTP_SERVER_REQUESTS_MAX_EXPECTED=10s
MANAGEMENT_MAX_URI_TAGS=100

# Staging MariaDB only. Use these values when rendering/mounting
# ops/mariadb/staging-slow-query.cnf.example; the application does not enable it.
MARIADB_SLOW_QUERY_TIME_SECONDS=0.250
MARIADB_SLOW_QUERY_MIN_EXAMINED_ROWS=100

# Use update only for controlled local development. Prefer validate in production
# and manage schema changes with versioned migrations.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Generate at least 32 cryptographically random bytes for this value.
# Never reuse the same signing key between local, staging, and production.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_EXPIRATION_MS=3600000

# Login rate limiting
APP_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
APP_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# Cloudinary backend credentials. Never expose API secrets as VITE_* variables.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Upload limits
MULTIPART_MAX_FILE_SIZE=2MB
MULTIPART_MAX_REQUEST_SIZE=2MB
