# Mount as a MariaDB server configuration file only in staging, for example:
# /etc/mysql/mariadb.conf.d/60-spacekids-slow-query.cnf
#
# Set long_query_time to the value of MARIADB_SLOW_QUERY_TIME_SECONDS from the
# staging environment when rendering/deploying this file. MariaDB cnf files do
# not expand application environment variables themselves.

[mariadb]
slow_query_log=ON
slow_query_log_file=/var/log/mysql/mariadb-slow.log
long_query_time=0.250
min_examined_row_limit=100
log_output=FILE
general_log=OFF

# Do not enable log_queries_not_using_indexes by default: it is commonly noisy
# and should only be used during a bounded investigation.
